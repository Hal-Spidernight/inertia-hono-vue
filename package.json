{
  "name": "inertia-hono-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "$npm_execpath run build && vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "format": "oxfmt src/ app/"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@inertiajs/vue3": "^3.0.3",
    "hono": "^4.12.14",
    "vue": "3.6.0-beta.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.45.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-ssr-components": "^0.5.2",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.17.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
